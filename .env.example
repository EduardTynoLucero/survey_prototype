# =====================================================================
#  Copie este archivo como  .env  y complete los valores.
#      cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# URL pública del servidor. Es la que viaja dentro del mensaje de
# WhatsApp, así que el doctor tiene que poder abrirla desde su teléfono.
# Con dominio y HTTPS detrás de un proxy:
BASE_URL=https://encuestas.sudominio.com
# Sin dominio, solo para probar en la red interna:
# BASE_URL=http://192.168.1.20:3000

PORT=3000

# ---------------------------------------------------------------------
# CANAL DE WHATSAPP — elija UNO
# ---------------------------------------------------------------------

# Opción A (recomendada en servidor): API oficial de Meta.
# No usa Chromium, no hay QR que escanear y la sesión no se cae.
# developers.facebook.com → app Business → producto WhatsApp
WA_TOKEN=
WA_PHONE_ID=

# Opción B: whatsapp-web.js. Deje WA_TOKEN y WA_PHONE_ID vacíos y el
# contenedor usará el Chromium que ya trae. Hay que entrar a
# /privado/ → WhatsApp y escanear el QR una sola vez; la sesión queda
# guardada en el volumen.
